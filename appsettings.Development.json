{
  "Authentication": {
    "Jwt": {
      "Issuer": "dotnet-crm",
      "Audience": "dotnet-crm-frontend",
      "AccessTokenMinutes": 5,
      "RefreshTokenIdleDays": 7,
      "RefreshTokenAbsoluteDays": 30
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5001"
    ]
  },
  "Email": {
    "EmailVerificationUrl": "http://localhost:5001/verify-email",
    "PasswordResetUrl": "http://localhost:5001/reset-password",
    "Smtp": {
      "Host": "localhost",
      "Port": 1025,
      "FromAddress": "no-reply@crm.local",
      "FromName": "CRM",
      "UseStartTls": false
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
